library(faux)
set.seed(123)
n <- 30
nsim <- 5000
# Population means: rows = time, columns = group
mu <- data.frame(
Control = c(50, 50),
Intervention = c(50, 55),
row.names = c("pre", "post")
)
p_values <- replicate(nsim, {
# Simulate one dataset
dat <- sim_design(
within = list(time = c("pre", "post")),
between = list(group = c("Control", "Intervention")),
n = n,
mu = mu,
sd = 10,
r = 0.60,
long = FALSE,
plot = FALSE
)
# ANCOVA
model <- lm(post ~ group + pre, data = dat)
# Extract p-value for group effect
coef(summary(model))["groupIntervention", "Pr(>|t|)"]
})
# Estimated power
mean(p_values < 0.05, na.rm = TRUE)
#| label: fig-ci-precision
#| fig-width: 10
#| fig-height: 4
#| fig-cap: "Precision of effect size estimates for different sample sizes."
library(ggplot2)
library(patchwork)
true_d <- 0.2
make_ci_data <- function(n) {
se <- sqrt(2 / n + true_d^2 / (4 * n))
data.frame(
study = factor(5:1),
estimate = true_d,
lower = true_d - 1.96 * se,
upper = true_d + 1.96 * se
)
}
plot_ci <- function(n) {
dat <- make_ci_data(n)
ggplot(dat, aes(y = study, x = estimate)) +
geom_vline(
xintercept = true_d,
linetype = "dashed",
color = "red"
) +
geom_segment(
aes(x = lower, xend = upper, yend = study),
linewidth = 1
) +
geom_point(size = 2.5) +
labs(
title = paste0("n = ", n, " per group"),
x = "Cohen's d (95% CI)",
y = NULL
) +
scale_x_continuous(limits = c(-0.5, 0.9)) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank(),
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
}
plot_ci(20) + plot_ci(200)
library(ggplot2)
library(dplyr)
set.seed(123)
# Design parameters
sample_sizes <- c(20, 120, 360)
true_effect <- 0.2
n_studies <- 5
# Generate confidence intervals for each sample size
df <- expand.grid(
n_total = sample_sizes,
study = seq_len(n_studies)
) |>
rowwise() |>
mutate(
n_group = n_total / 2,
# Standard error for Cohen's d (approximation)
se = sqrt(2 / n_group + true_effect^2 / (2 * n_total)),
estimate = rnorm(1, mean = true_effect, sd = se),
lower = estimate - 1.96 * se,
upper = estimate + 1.96 * se
) |>
ungroup() |>
mutate(
sample_size = factor(
n_total,
levels = sample_sizes,
labels = c("N = 20 (10/group)",
"N = 120 (60/group)",
"N = 360 (180/group)")
),
study = factor(study, levels = rev(seq_len(n_studies)))
)
# Plot
ggplot(df, aes(y = study, x = estimate)) +
geom_vline(
xintercept = true_effect,
linetype = "dashed",
color = "grey40"
) +
geom_segment(
aes(x = lower, xend = upper, yend = study),
linewidth = 0.8
) +
geom_point(size = 2) +
facet_wrap(~ sample_size, nrow = 1) +
labs(
x = "Estimated effect size (Cohen's d)",
y = "Study",
title = "Larger samples provide more precise effect estimates",
subtitle = "Five illustrative studies per sample size; true effect size = 0.2",
caption = "Points represent estimates; horizontal lines represent 95% confidence intervals."
) +
theme_minimal(base_size = 12) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank(),
strip.text = element_text(face = "bold"),
plot.title = element_text(face = "bold"),
axis.text.y = element_blank(),
axis.ticks.y = element_blank()
)
library(faux)
library(dplyr)
library(tidyr)
library(lme4)
library(lmerTest)
set.seed(123)
n <- 250
nsim <- 2000
cors <- c(0.70, 0.492, 0.70)
simulate_data <- function(n) {
dat_a <- rnorm_multi(
n = n,
mu = c(30, 20, 28),
sd = c(5, 5, 5),
r = cors,
varnames = c("measure.1", "measure.2", "measure.3")
) |>
mutate(tx = "A")
dat_b <- rnorm_multi(
n = n,
mu = c(30, 20, 22),
sd = c(5, 5, 5),
r = cors,
varnames = c("measure.1", "measure.2", "measure.3")
) |>
mutate(tx = "B")
bind_rows(dat_a, dat_b) |>
mutate(subject.id = factor(row_number())) |>
pivot_longer(
cols = starts_with("measure."),
names_to = "time",
values_to = "measure"
) |>
mutate(
time = factor(time, levels = c("measure.1", "measure.2", "measure.3")),
tx = factor(tx)
)
}
p_values <- replicate(nsim, {
dat <- simulate_data(n)
model <- lmerTest::lmer(
measure ~ time * tx + (1 | subject.id),
data = dat
)
})
power <- mean(p_values < 0.05, na.rm = TRUE)
power
