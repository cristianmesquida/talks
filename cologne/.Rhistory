library(faux)
library(dplyr)
library(tidyr)
library(lme4)
library(lmerTest)
set.seed(123)
n <- 250
nsim <- 100
cors <- c(0.70, 0.492, 0.70)
simulate_data <- function(n) {
dat_a <- rnorm_multi(
n = n,
mu = c(30, 20, 28),
sd = c(5, 5, 5),
r = cors,
varnames = c("measure.1", "measure.2", "measure.3")
) |>
mutate(tx = "A")
dat_b <- rnorm_multi(
n = n,
mu = c(30, 20, 22),
sd = c(5, 5, 5),
r = cors,
varnames = c("measure.1", "measure.2", "measure.3")
) |>
mutate(tx = "B")
bind_rows(dat_a, dat_b) |>
mutate(subject.id = factor(row_number())) |>
pivot_longer(
cols = starts_with("measure."),
names_to = "time",
values_to = "measure"
) |>
mutate(
time = factor(time, levels = c("measure.1", "measure.2", "measure.3")),
tx = factor(tx)
)
}
p_values <- replicate(nsim, {
dat <- simulate_data(n)
model <- lmer(
measure ~ time * tx + (1 | subject.id),
data = dat
)
anova(model)["time:tx", "Pr(>F)"]
})
# Estimate power
mean(p_values < 0.05)
